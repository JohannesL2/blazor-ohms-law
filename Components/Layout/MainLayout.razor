@inherits LayoutComponentBase

<div class="page">

    <main>
        <div class="top-row px-4" style="display: flex; justify-content: space-between; align-items: center;">
            <a href="" style="font-weight: 600; text-decoration: none; color: inherit; font-size: 1.1rem;">
                Ohm's Law calculator
            </a>

            <a href="https://github.com/JohannesL2/blazor-ohms-law/" target="_blank" rel="noopener noreferrer" style="text-decoration: none; font-weight: 500;">
                GitHub ↗
            </a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
